              "mode": "raw",
              "raw": "{\n  \"keterangan\": \"Updated: PMK revisi\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/pmk/1",
              "host": ["{{baseUrl}}"],
              "path": ["pmk", "1"]
            }
          }
        }
      ]
    },
