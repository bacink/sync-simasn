    {
      "name": "Error Responses",
      "item": [
        {
          "name": "401 - Invalid Credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401', pm.response.code === 401);",
                  "pm.test('Error code AUTH_INVALID_CREDENTIALS', pm.response.json().error.code === 'AUTH_INVALID_CREDENTIALS');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"wrong@bpsdm.id\",\n  \"password\": \"wrongpass\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "404 - KGB Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 404', pm.response.code === 404);",
                  "pm.test('Error code KGB_NOT_FOUND', pm.response.json().error.code === 'KGB_NOT_FOUND');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/kgb/999999",
              "host": ["{{baseUrl}}"],
              "path": ["kgb", "999999"]
            }
          }
        },
        {
          "name": "422 - Validation Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 422', pm.response.code === 422);",
                  "pm.test('Error code VALIDATION_ERROR', pm.response.json().error.code === 'VALIDATION_ERROR');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pegawai_id\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/kgb/generate",
              "host": ["{{baseUrl}}"],
              "path": ["kgb", "generate"]
            }
          }
